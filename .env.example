# Server
PORT=4000
# Comma-separated list of allowed browser origins (prod domain + any preview URLs)
# prod: https://app.betterpomo.com,https://betterpomo.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Where password-reset emails land (the webapp's /auth/callback lives here).
# prod: https://app.betterpomo.com — must be in Supabase's allowed redirect URLs.
WEB_URL=http://localhost:3000
# Where Stripe checkout success/cancel redirects land (the web app). Code defaults
# to https://app.betterpomo.com when unset; set localhost for local billing tests.
WEBAPP_URL=http://localhost:3000
# Max requests per IP per minute across /api (DoS backstop; raise if legitimate
# traffic is ever throttled).
RATE_LIMIT_MAX=600
# Optional. Set to run more than one API instance: enables a shared rate-limit
# counter (global, not N× per instance) and cross-instance cache invalidation.
# Unset = single-instance in-memory behaviour. e.g. redis://default:pass@host:6379
REDIS_URL=

# Expo Push Service. Enable push security in the Expo dashboard and store the
# resulting access token here. Leave unset only for local development.
EXPO_ACCESS_TOKEN=

# Email (Resend). Unset = all email sending + drip scheduler disabled.
RESEND_API_KEY=
# Must use a domain verified in the Resend account. `onboarding@resend.dev`
# can only send to the email address that owns the Resend account.
RESEND_FROM_EMAIL=no-reply@auth.betterpomo.com
# Auth can use a dedicated sender. Defaults to RESEND_FROM_EMAIL when unset.
AUTH_FROM_EMAIL=no-reply@auth.betterpomo.com
# Optional: enables the signed Supabase Send Email hook for Auth messages that
# are triggered outside the API-owned signup/resend/recovery flows.
SEND_EMAIL_HOOK_SECRET=
# OTPs are logged by default outside production. Set true temporarily in a
# deployed test environment, or false to suppress them everywhere.
LOG_AUTH_CODES=
# Owner-only notification addresses. These are never used as fallbacks for
# authentication, confirmation, recovery, or other user-facing email.
WISHLIST_NOTIFY_EMAIL=you@example.com
CONTACT_NOTIFY_EMAIL=you@example.com
# Public origin of this API — used in unsubscribe links. prod: https://api.betterpomo.com
API_PUBLIC_URL=http://localhost:4000
# Secret for signing unsubscribe tokens. Set a unique random value per environment
# (no longer falls back to the service-role key).
UNSUBSCRIBE_SECRET=
# Comma-separated admin emails (feedback board status control).
ADMIN_EMAILS=you@example.com

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key — bypasses RLS. Server-only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
